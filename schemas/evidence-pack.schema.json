{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standards.rmd.dev/v0.1/evidence-pack.schema.json",
  "title": "Rich Media Document (RMD) Grounded Evidence Pack",
  "description": "Deterministic evidence schema delivered to multimodal LLMs and autonomous agents for zero-hallucination grounded reasoning.",
  "type": "object",
  "required": ["documentId", "generatedAt", "agent", "claims"],
  "properties": {
    "documentId": { "type": "string" },
    "documentTitle": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "agent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groundedClaim"
      }
    },
    "auditTrail": {
      "type": "object",
      "properties": {
        "totalEvidenceNodes": { "type": "integer" },
        "minConfidenceObserved": { "type": "number" },
        "cryptographicIntegrityVerified": { "type": "boolean" },
        "provenanceIssuer": { "type": "string" }
      }
    }
  },
  "$defs": {
    "groundedClaim": {
      "type": "object",
      "required": ["id", "claimText", "confidence", "source", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "claimText": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "enum": ["human", "model", "extracted", "verified"] },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceAnchor"
          }
        }
      }
    },
    "evidenceAnchor": {
      "type": "object",
      "required": ["annotationId", "mediaId", "mediaKind", "mediaSrc"],
      "properties": {
        "annotationId": { "type": "string" },
        "mediaId": { "type": "string" },
        "mediaKind": { "type": "string", "enum": ["image", "video", "audio", "document", "dataset", "3d"] },
        "mediaSrc": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "location": {
          "$ref": "#/$defs/selector"
        },
        "extractedContent": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "ocrText": { "type": "string" },
            "transcriptSlice": { "type": "string" },
            "label": { "type": "string" },
            "rawSliceUrl": { "type": "string" }
          }
        }
      }
    },
    "spatialSelector": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["xywh", "polygon", "normalized-xywh", "spatial"] },
        "unit": { "enum": ["pixel", "percent", "normalized"], "default": "pixel" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3
        }
      }
    },
    "temporalSelector": {
      "type": "object",
      "required": ["type", "start", "end"],
      "properties": {
        "type": { "const": "temporal" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "frameStart": { "type": "integer", "minimum": 0 },
        "frameEnd": { "type": "integer", "minimum": 0 },
        "timebase": { "type": "string" },
        "chapterId": { "type": "string" }
      }
    },
    "textRangeSelector": {
      "type": "object",
      "required": ["type", "startOffset", "endOffset"],
      "properties": {
        "type": { "const": "text-range" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "exact": { "type": "string" },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" }
      }
    },
    "compositeSelector": {
      "type": "object",
      "required": ["type", "chain"],
      "properties": {
        "type": { "const": "composite" },
        "chain": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/selector" }
        }
      }
    },
    "selector": {
      "oneOf": [
        { "$ref": "#/$defs/spatialSelector" },
        { "$ref": "#/$defs/temporalSelector" },
        { "$ref": "#/$defs/textRangeSelector" },
        { "$ref": "#/$defs/compositeSelector" }
      ]
    }
  }
}
